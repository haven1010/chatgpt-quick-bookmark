{
  "manifest_version": 3,
  "name": "ChatGPT 随手书签",
  "version": "1.2.0",
  "description": "在 ChatGPT 对话中保存多个阅读位置，随时跳回。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["bookmarks.js"],
      "run_at": "document_idle"
    }
  ]
}
